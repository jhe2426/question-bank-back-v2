{
  "openapi": "3.0.3",
  "info": {
    "title": "관리자 회원관리 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/admin/users": {
      "get": {
        "summary": "관리자 회원 목록 조회",
        "operationId": "getAdminUsers",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "keyword", "in": "query", "schema": {"type": "string", "maxLength": 50}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
          {"name": "size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}
        ],
        "responses": {
          "200": {"description": "회원 목록과 페이지 정보"},
          "400": {"description": "잘못된 페이징 또는 검색 조건"},
          "401": {"description": "인증되지 않음"},
          "403": {"description": "ADMIN 권한 없음"}
        }
      }
    },
    "/api/admin/users/{userId}/learning-summary": {
      "get": {
        "summary": "회원별 학습 현황 조회",
        "operationId": "getAdminUserLearningSummary",
        "description": "풀이 문항 수는 중복 문제를 제외한다. 전체 시간은 응시 그룹의 실제 시간 합계이며 섹션별 시간은 측정 데이터가 없어 null이다.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "userId", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "회원 기본 정보와 전체·섹션별 학습 현황"},
          "401": {"description": "인증되지 않음"},
          "403": {"description": "ADMIN 권한 없음"},
          "404": {
            "description": "회원 없음",
            "content": {"application/json": {"example": {"code": "NUI", "message": "User ID does not exist."}}}
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    }
  }
}
