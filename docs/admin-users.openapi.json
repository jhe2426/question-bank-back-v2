{
  "openapi": "3.0.3",
  "info": {
    "title": "관리자 회원관리 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/admin/users": {
      "get": {
        "summary": "관리자 회원 목록 조회",
        "operationId": "getAdminUsers",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "keyword", "in": "query", "schema": {"type": "string", "maxLength": 50}},
          {"name": "page", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
          {"name": "size", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}}
        ],
        "responses": {
          "200": {"description": "회원 목록과 페이지 정보"},
          "400": {"description": "잘못된 페이징 또는 검색 조건"},
          "401": {"description": "인증되지 않음"},
          "403": {"description": "ADMIN 권한 없음"}
        }
      }
    },
    "/api/admin/users/{userId}/learning-summary": {
      "get": {
        "summary": "회원별 학습 현황 조회",
        "operationId": "getAdminUserLearningSummary",
        "description": "섹션별 풀이 횟수는 user_solved_history의 이력 행을 기준으로 하므로 동일 문제의 재풀이도 각각 집계한다. 기존 totalSolvedCount는 중복 문제를 제외한다. 전체 시간은 JOIN 없이 응시 그룹의 실제 시간만 합산하며, 섹션별 시간은 제공하지 않는다.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "userId", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "회원 기본 정보와 전체·섹션별 학습 현황",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/AdminUserLearningSummary"}
              }
            }
          },
          "401": {"description": "인증되지 않음"},
          "403": {"description": "ADMIN 권한 없음"},
          "404": {
            "description": "회원 없음",
            "content": {"application/json": {"example": {"code": "NUI", "message": "User ID does not exist."}}}
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "schemas": {
      "AdminUserLearningSummary": {
        "type": "object",
        "required": ["code", "message", "userId", "userName", "phoneNumber", "totalSolvedCount", "totalSolveSeconds", "sectionSummaries"],
        "properties": {
          "code": {"type": "string", "example": "SU"},
          "message": {"type": "string", "example": "Success."},
          "userId": {"type": "string"},
          "userName": {"type": "string"},
          "phoneNumber": {"type": "string"},
          "totalSolvedCount": {"type": "integer", "format": "int64", "minimum": 0},
          "totalSolveSeconds": {"type": "integer", "format": "int64", "minimum": 0, "nullable": true},
          "sectionSummaries": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/AdminSectionLearningSummary"}
          }
        }
      },
      "AdminSectionLearningSummary": {
        "type": "object",
        "required": ["sectionId", "sectionName", "solvedCount", "correctCount", "accuracyRate"],
        "properties": {
          "sectionId": {"type": "integer"},
          "sectionName": {"type": "string"},
          "solvedCount": {"type": "integer", "format": "int64", "minimum": 0},
          "correctCount": {"type": "integer", "format": "int64", "minimum": 0},
          "accuracyRate": {"type": "number", "format": "double", "minimum": 0, "maximum": 100}
        }
      }
    }
  }
}
