{
  "openapi": "3.0.3",
  "info": {
    "title": "관리자 문제 목록 조회 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/admin/questions": {
      "get": {
        "operationId": "getAdminQuestions",
        "summary": "관리자 조건별 문제 목록 조회",
        "description": "ADMIN 역할 필요. 기출문제는 questionOrder 오름차순(동률은 연결 ID 오름차순), 모의고사는 questionId 내림차순. 해당 조건의 결과가 없거나 페이지 범위를 벗어나면 빈 questions와 200을 반환한다. 다른 유형에만 쓰이는 조건과 sort는 조회에 적용하지 않는다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "questionType",
            "in": "query",
            "required": true,
            "description": "문제 유형",
            "schema": {
              "type": "string",
              "enum": [
                "기출문제",
                "모의고사"
              ]
            }
          },
          {
            "name": "pastExamRound",
            "in": "query",
            "required": false,
            "description": "기출문제 조회 시 필수. 내부 ID가 아닌 실제 회차.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "description": "모의고사 조회 시 필수.",
            "schema": {
              "type": "string",
              "enum": [
                "상",
                "중",
                "하"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "0부터 시작하는 페이지 번호",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "페이지 크기. 범위를 벗어나면 400.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "questions",
                    "totalElements",
                    "totalPages",
                    "page",
                    "size",
                    "last"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "SU"
                    },
                    "message": {
                      "type": "string",
                      "example": "Success."
                    },
                    "questions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdminQuestionListItem"
                      }
                    },
                    "totalElements": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "totalPages": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "page": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "size": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "last": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "필수 조건 누락, 잘못된 유형/난이도/정수/페이지 범위",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "code": "VF",
                  "message": "Validation failed."
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 사용자"
          },
          "403": {
            "description": "ADMIN 권한 없음"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AdminQuestionListItem": {
        "type": "object",
        "required": [
          "questionId",
          "sectionId",
          "pastExamRound",
          "questionOrder",
          "questionType",
          "questionText",
          "difficulty",
          "imageUrl"
        ],
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "sectionId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pastExamRound": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "questionOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "questionType": {
            "type": "string"
          },
          "questionText": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
