{
  "openapi": "3.0.3",
  "info": {
    "title": "관리자 문제 목록 조회 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/admin/questions": {
      "get": {
        "operationId": "getAdminQuestions",
        "summary": "관리자 조건별 문제 목록 조회",
        "description": "ADMIN 역할 필요. 기출문제는 questionOrder 오름차순(동률은 연결 ID 오름차순), 모의고사는 questionId 내림차순. 해당 조건의 결과가 없거나 페이지 범위를 벗어나면 빈 questions와 200을 반환한다. 다른 유형에만 쓰이는 조건과 sort는 조회에 적용하지 않는다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "questionType",
            "in": "query",
            "required": true,
            "description": "문제 유형",
            "schema": {
              "type": "string",
              "enum": [
                "기출문제",
                "모의고사"
              ]
            }
          },
          {
            "name": "pastExamRound",
            "in": "query",
            "required": false,
            "description": "기출문제 조회 시 필수. 내부 ID가 아닌 실제 회차.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1
            }
          },
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "description": "모의고사 조회 시 필수.",
            "schema": {
              "type": "string",
              "enum": [
                "상",
                "중",
                "하"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "0부터 시작하는 페이지 번호",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "페이지 크기. 범위를 벗어나면 400.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "questions",
                    "totalElements",
                    "totalPages",
                    "page",
                    "size",
                    "last"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "SU"
                    },
                    "message": {
                      "type": "string",
                      "example": "Success."
                    },
                    "questions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdminQuestionListItem"
                      }
                    },
                    "totalElements": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "totalPages": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "page": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "size": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "last": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "필수 조건 누락, 잘못된 유형/난이도/정수/페이지 범위",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "code": "VF",
                  "message": "Validation failed."
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 사용자"
          },
          "403": {
            "description": "ADMIN 권한 없음"
          }
        }
      }
    },
    "/api/admin/questions/{questionId}": {
      "get": {
        "operationId": "getAdminQuestionDetail",
        "summary": "관리자 단일 문제 상세 조회",
        "description": "기존 저장된 문제 및 해설 URL을 그대로 반환한다. 기출문제는 실제 회차와 순서, 모의고사는 tags 배열을 반환한다. 상세 해설이 없으면 null, 기출 연결 정보가 없으면 회차와 순서는 null이다.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminQuestionDetail"
                }
              }
            }
          },
          "400": {
            "description": "문제 ID의 정수 형식이 잘못됨",
            "content": {
              "application/json": {
                "example": {
                  "code": "VF",
                  "message": "Validation failed."
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않음"
          },
          "403": {
            "description": "ADMIN 권한 없음"
          },
          "404": {
            "description": "존재하지 않는 문제 ID",
            "content": {
              "application/json": {
                "example": {
                  "code": "NQI",
                  "message": "Question ID does not exist."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AdminQuestionListItem": {
        "type": "object",
        "required": [
          "questionId",
          "sectionId",
          "pastExamRound",
          "questionOrder",
          "questionType",
          "questionText",
          "difficulty",
          "imageUrl"
        ],
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "sectionId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pastExamRound": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "questionOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "questionType": {
            "type": "string"
          },
          "questionText": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AdminQuestionDetail": {
        "type": "object",
        "required": [
          "questionId",
          "sectionId",
          "pastExamRound",
          "questionOrder",
          "questionType",
          "questionText",
          "difficulty",
          "imageUrl",
          "option1",
          "option2",
          "option3",
          "option4",
          "shortExplanation",
          "code",
          "message",
          "answer",
          "tags",
          "detailedExplanation"
        ],
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "sectionId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pastExamRound": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "questionOrder": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "questionType": {
            "type": "string"
          },
          "questionText": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "option1": {
            "type": "string",
            "nullable": false
          },
          "option2": {
            "type": "string",
            "nullable": false
          },
          "option3": {
            "type": "string",
            "nullable": false
          },
          "option4": {
            "type": "string",
            "nullable": false
          },
          "shortExplanation": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "example": "SU"
          },
          "message": {
            "type": "string",
            "example": "Success."
          },
          "answer": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "모의고사에 연결된 실제 기출 회차. 오름차순. 없으면 빈 배열."
          },
          "detailedExplanation": {
            "type": "object",
            "nullable": true,
            "required": [
              "content",
              "imageUrl"
            ],
            "properties": {
              "content": {
                "type": "string",
                "nullable": true
              },
              "imageUrl": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
